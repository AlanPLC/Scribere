# Conseguí una API key gratis en https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: modelo de Groq a usar (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-20b

# Redis (Upstash, capa gratis) para el rate limit por IP y los cupos
# compartidos visibles en la página. Si se dejan vacías, la app sigue
# funcionando con un rate limit en memoria (débil en producción/serverless).
# Creá una base en https://console.upstash.com -> Redis -> Create Database,
# copiá el "REST URL" y el "REST TOKEN" de la pestaña "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
